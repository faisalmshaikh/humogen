{
    "require": {
        "phpmailer/phpmailer": "^6.9",
        "google/apiclient": "^2.19"
    },
    "extra": {
        "google/apiclient-services": [
            "Sheets"
        ]
    },
    "autoload": {
        "psr-4": {
            "Genealogy\\App\\": "app/",
            "Genealogy\\Include\\": "include/",
            "Genealogy\\Languages\\": "languages/",
            "Genealogy\\Admin\\": "admin/"
        },
        "classmap": [
            "include/",
            "include/tfpdf/"
        ]
    },
    "config": {
        "process-timeout": 0
    }
}
